# LTA_ACCOUNT_KEY: Singapore LTA DataMall API Account Key.
# Obtain from https://datamall.lta.gov.sg/content/datamall/en/request-api.html
# Kept strictly server-side; NEVER exposed to the client.
LTA_ACCOUNT_KEY="replace_with_lta_account_key"

# Optional Mock Data override for offline testing (true | false)
MOCK_LTA_DATA="false"

# Optional Maps API configuration
MAPS_API_KEY="replace_with_maps_api_key"
NEXT_PUBLIC_MAPS_PROVIDER="leaflet"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

